    }

    // Если путь не найден, возвращаем пустой результат
    return {};
}

// Алгоритм Дейкстры
std::vector<Node*> dijkstra(Graph& graph, Node* start, Node* target) {
    std::unordered_map<Node*, double> distances;
    std::unordered_map<Node*, Node*> came_from;

    // Приоритетная очередь для выбора узлов с минимальным текущим весом
    auto compare = [&distances](Node* a, Node* b) { return distances[a] > distances[b]; };
    std::priority_queue<Node*, std::vector<Node*>, decltype(compare)> pq(compare);

    // Инициализация расстояний
    for (auto node : graph.nodes) {
        distances[node] = std::numeric_limits<double>::infinity();
    }
    distances[start] = 0.0;
    pq.push(start);

    while (!pq.empty()) {
        Node* current = pq.top();
        pq.pop();

        // Если достигли цели, восстанавливаем путь
        if (current == target) {
            std::vector<Node*> path;
            for (Node* at = target; at != nullptr; at = came_from[at]) {
                path.push_back(at);
            }
            std::reverse(path.begin(), path.end());
            return path;
        }

        // Обрабатываем соседей текущего узла
        for (const auto& [neighbor, weight] : current->neighbors) {
            double new_dist = distances[current] + weight;
            if (new_dist < distances[neighbor]) {
                distances[neighbor] = new_dist;
                came_from[neighbor] = current;
                pq.push(neighbor);
            }
        }
    }

    // Если путь не найден, возвращаем пустой результат
    return {};
}

// Вывод пути
void print_path(const std::vector<Node*>& path) {
    auto start_time = std::chrono::high_resolution_clock::now();

    if (path.empty()) {
        std::cout << "Путь не найден\n";
        return;
    }

    std::cout << "Путь:\n";
    int path_count = 0;
    for (auto node : path) {
        std::cout << std::fixed << std::setprecision(8); // Устанавливаем точность до 8 знаков
        std::cout << "(" << node->lat << ", " << node->lon << ") -> ";
        path_count++;
    }
    std::cout << "Конец\n";

    auto end_time = std::chrono::high_resolution_clock::now();
    std::cout << "Время работы: " << std::chrono::duration_cast<std::chrono::milliseconds>(end_time - start_time).count() << " ms\n";
    std::cout << "Количество путей:" << path_count << "\n";
}

int main() {
    try {
        // Загружаем граф из файла
        Graph graph = load_graph("spb_graph.txt");

        // Указываем координаты начальной и конечной точек
        
        double start_lat = 60.050257, start_lon = 30.436555;
        double target_lat = 59.956665, target_lon = 30.308456;

        // Находим ближайшие узлы к этим координатам
        Node* start = graph.find_closest_node(start_lat, start_lon);
        Node* target = graph.find_closest_node(target_lat, target_lon);

        if (!start || !target) {
            std::cerr << "Не удалось найти начальный или конечный узел\n";
            return 1;
        }

        // Запускаем BFS
        std::vector<Node*> path_bfs = bfs(graph, start, target);
        std::cout << "Результат BFS:\n";
        print_path(path_bfs);

        // Запускаем DFS
        std::vector<Node*> path_dfs = dfs(graph, start, target);
        std::cout << "Результат DFS:\n";
        print_path(path_dfs);

        // Запускаем Дейкстру
        std::vector<Node*> path_dijkstra = dijkstra(graph, start, target);
        std::cout << "Результат Дейкстры:\n";
        print_path(path_dijkstra);

    } catch (const std::exception& ex) {
        std::cerr << "Ошибка: " << ex.what() << std::endl;
        return 1;
    }

    return 0;
}
